<?xml version="1.0" encoding="utf-8"?>
<!-- Solid blue backdrop for the adaptive launcher icon (see DESIGN.md palette).
     Vector drawables only support <path> elements — a full-canvas path is the
     correct way to draw a filled rectangle here (a <rect> element fails
     resource linking). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0c65a5"
        android:pathData="M0,0 H108 V108 H0 Z" />
</vector>
