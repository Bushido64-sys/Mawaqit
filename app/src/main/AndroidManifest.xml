<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location — GPS-based prayer times and Qibla direction -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Exact Alarm — precise prayer alarm scheduling (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Boot receiver — reschedule alarms after phone restart (Phase 3) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground service — Azan audio playback (Phase 3) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Notifications — Android 13+ requires explicit permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration — alarm vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Internet — AlAdhan + UmmahAPI calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network state — offline detection -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wake lock — keep CPU awake to fire alarm at exact time -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Battery optimization exemption prompt (Settings screen) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".MawaqitApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mawaqit"
        android:forceDarkAllowed="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mawaqit.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── PHASE_3: alarm machinery ───────────────────────────────── -->

        <!-- Alarm receiver — fires when AlarmManager triggers a prayer -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mawaqit.app.PRAYER_ALARM" />
            </intent-filter>
        </receiver>

        <!-- System-event receiver — reschedules alarms after reboot (PHASE_3)
             and after clock/timezone changes (PHASE-3.1, GAP-2: both can leave
             armed alarm wall-times stale). Both are on Android's official
             implicit-broadcast exemption list (developer.android.com
             /broadcast-exceptions), so manifest registration is valid.
             MY_PACKAGE_REPLACED was REMOVED (PHASE-3.2): that broadcast is
             explicitly NOT exempt — a manifest registration never fires it.
             App updates are still covered: alarms self-fire (setAlarmClock
             slots survive updates), the daily housekeeping job re-arms, and
             the next app open re-arms.
             LOCKED_BOOT_COMPLETED is registered but ignored in code:
             Room/DataStore (credential-encrypted) are unreadable pre-unlock
             (see PERMISSIONS.md note and BootReceiver). -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Mark-as-Prayed handler for the azan notification (explicit intent) -->
        <receiver
            android:name=".alarm.AzanReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Azan playback foreground service -->
        <service
            android:name=".alarm.AzanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- WorkManager: disable the DEFAULT initializer so WorkManager uses
             MawaqitApplication.workManagerConfiguration (HiltWorkerFactory).
             Required by @HiltWorker classes; PERMISSIONS.md provider block. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Widget provider (Phase 5): 2x1 Glance widget. exported=false is
             correct — APPWIDGET_UPDATE is a protected system broadcast. -->
        <receiver
            android:name=".widget.MawaqitWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mawaqit_widget_info" />
        </receiver>

    </application>
</manifest>
